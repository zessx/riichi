msgstr "Quelques combinaisons / yakus « ouverts »"

msgid "simplified rules"
msgstr "règles simplifiées"

msgid "All Simples"
msgstr "Tout Ordinaire"

msgid "Hand without Terminals (1 or 9) or Honors."
msgstr "Main sans Terminales (1 ou 9) ni Honneurs."

msgid "Terminals and Honors Everywhere"
msgstr "Terminales et Honneurs Partout"

