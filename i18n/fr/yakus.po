# ——— YAKUS BASED ON SEQUENCES ———

msgid "Yakus based on sequences"
msgstr "Yakus basés sur des suites"

msgid "Common"
msgstr "Commun"

msgid "Pure Double Sequence"
msgstr "Double Suite Pure"

msgid "Two Pure Double Sequences"
msgstr "Deux Doubles Suites Pures"

msgid "Pinfu"
msgstr "Pinfu"

msgid "Hand without any fu : 4 Sequences and 1 valueless Pair, with a double wait."
msgstr "Main sans aucun fu : 4 Suites et 1 Paire sans valeur, en double attente."

msgid "Three Colored Sequences"
msgstr "Triple Suite"

msgid "Pure Straight"
msgstr "Grande Suite"

# ——— OTHER YAKUS ———

msgid "Other yakus"
msgstr "Autrs yakus"

msgid "Riichi"
msgstr "Riichi"

msgid "Double Riichi"
msgstr "Double Riichi"

msgid "Riichi announced during the very first uninterrupted round."
msgstr "Annonce du Riichi durant le tout premier tour ininterrompu."

msgid "Ippatsu"
msgstr "Ippatsu"

msgid "Win during the first uninterrupted round following the Riichi announcement."
msgstr "Gagner durant le premier tour ininterrompu suivant lannonce du Riichi."

msgid "All Concealed Self Draw"
msgstr "Tout Caché Tiré"

msgid "Under the Sea"
msgstr "Fond de la Mer"

msgid "Win by last draw."
msgstr "Gagner sur pioche sur la dernière tuile du mur"

msgid "Under the River"
msgstr "Fond de la Rivière"

msgid "Win by last discard."
msgstr "Gagner sur écart après la dernière tuile du mur."

msgid "Dead Wall Draw"
msgstr "Finir sur un Carré"

msgid "Win on a Quad replacement tile."
msgstr "Gagner sur la tuile de remplacement dun Carré."

msgid "Robbing a Quad"
msgstr "Voler un Carré"

msgid "A concealed Quad can only be robbed to win Thirteen Orphans."
msgstr "Un Carré caché ne peut être volé que pour les Treize Orphelins."

msgid "Heavenly Hand"
msgstr "Bénédiction du Ciel"

msgid "East player wins on his initial hand."
msgstr "Le joueur Est gagne sur sa main initiale."

msgid "Earthly Hand"
msgstr "Bénédiction de la Terre"

msgid "Win on draw during the very first uninterrupted turn."
msgstr "Gagner sur pioche durant le tout premier tour ininterrompu."

msgid "Hand of Man"
msgstr "Bénédiction de l'Homme"

msgid "Win on discard during the very first uninterrupted turn, and before the player has had his first turn. No other yaku/dora can be added."
msgstr "Gagner sur écart durant le tout premier tour ininterrompu, et avant que le joueur ait eu son premier tour. On ne compte aucun autre yaku/dora."

