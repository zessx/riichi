# ——— BASIC ELEMENTS ———

msgid "Basic elements"
msgstr "基本要素"

msgid "Sequence"
msgstr "顺子（吃）"

msgid "Run of 3 tiles from the same suit"
msgstr "同花色三张连续的数牌"

msgid "On the previous player"
msgstr "只能从上家吃牌"

msgid "Triplet"
msgstr "刻子（碰）"

msgid "Set of 3 identical tiles"
msgstr "三张相同的牌"

msgid "On anybody"
msgstr "可以从任何人"

