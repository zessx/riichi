# ——— BASIC ELEMENTS ———

msgid "Basic elements"
msgstr "Các bộ cơ bản"

msgid "Sequence"
msgstr "Phình"

msgid "Run of 3 tiles from the same suit"
msgstr "3 quân đồng chất liên tiếp"

