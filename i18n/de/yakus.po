# ——— YAKUS BASED ON SEQUENCES ———

msgid "Yakus based on sequences"
msgstr "Auf folgen basierende yaku"

msgid "Common"
msgstr "Häufig"

msgid "Pure Double Sequence"
msgstr "Reine Doppelfolge"

msgid "Two Pure Double Sequences"
msgstr "Zwei Reine Doppelfolgen"

msgid "Pinfu"
msgstr "Wertlose Hand"

msgid "Hand without any fu : 4 Sequences and 1 valueless Pair, with a double wait."
msgstr "Hand ohne Fu: 4 Folgen und ein wertloses Paar, mit zweiseitiger Warte."

msgid "Three Colored Sequences"
msgstr "Gemischte Dreifachfolge"

msgid "Pure Straight"
msgstr "Straße"

# ——— OTHER YAKUS ———

msgid "Other yakus"
msgstr "Andere yaku"

msgid "Riichi"
msgstr "Riichi"

msgid "Double Riichi"
msgstr "Doppel-Riichi"

msgid "Riichi announced during the very first uninterrupted round."
msgstr "Riichi-Ansage während der ersten ununterbrochenen Runde."

msgid "Ippatsu"
msgstr "Ippatsu"

msgid "Win during the first uninterrupted round following the Riichi announcement."
msgstr "Sieg während der ersten ununterbrochenen Runde nach Riichi-Ansage."

msgid "All Concealed Self Draw"
msgstr "Komplett Verdeckte Hand"

msgid "Under the Sea"
msgstr "Letzter Stein"

msgid "Win by last draw."
msgstr "Sieg durch letztes Ziehen."

msgid "Under the River"
msgstr "Letzter Abgeworfener Stein"

msgid "Win by last discard."
msgstr "Sieg durch letzten Abwurfstein."

msgid "Dead Wall Draw"
msgstr "Ersatzsteinsieg"

msgid "Win on a Quad replacement tile."
msgstr "Sieg durch Ersatzstein für Vierling."

msgid "Robbing a Quad"
msgstr "Raub eines Kan"

msgid "A concealed Quad can only be robbed to win Thirteen Orphans."
msgstr "Ein verdeckter Vierling kann nur für die Dreizehn Waisen geraubt werden."

msgid "Heavenly Hand"
msgstr "Segen des Himmels"

msgid "East player wins on his initial hand."
msgstr "Ostspieler gewinnt mit anfänglicher Hand."

msgid "Earthly Hand"
msgstr "Segen der Erde"

msgid "Win on draw during the very first uninterrupted turn."
msgstr "Sieg durch Zug während der ersten ununterbrochenen Runde."

msgid "Hand of Man"
msgstr "Segen der Menschheit"

msgid "Win on discard during the very first uninterrupted turn, and before the player has had his first turn. No other yaku/dora can be added."
msgstr "Sieg durch einen Abwurfstein während der ersten ununterbrochenen Runde, und vor dem ersten Spielzug des Spielers. Nicht kombinierbar mit anderen Yaku/Dora."

# ——— DORA ———

msgid "Dora"
msgstr "Dora"

msgid "Uradora"
msgstr "Uradora"

msgid "Doras are not yakus."
msgstr "Dora sind keine Yaku."

# ——— YAKUS BASED ON TERMINALS / HONORS ———

msgid "Yakus based on terminals / honors"
msgstr "Auf endsteinen/ehren basierende yaku"

msgid "All Simples"
msgstr "Nur einfache Steine"

msgid "Hand without Terminals or Honors."
msgstr "Hand ohne Endsteine oder Ehren."

msgid "Value Triplet"
msgstr "Wertsteindrilling"

msgid "Dragon, Player's Seat Wind or Round Wind Triplet."
msgstr "Drachen, Spielerwind oder Rundenwind Drilling."

msgid "Small Three Dragons"
msgstr "Kleine Drei Drachen"

msgid "Big Three Dragons"
msgstr "Große Drei Drachen"

msgid "Little Four Winds"
msgstr "Kleine Vier Winde"

msgid "Big Four Winds"
msgstr "Große Vier Winde"

msgid "Terminals and Honors Everywhere"
msgstr "Überall Endsteine und Ehren"

msgid "Terminals Everywhere"
msgstr "Überall Endsteine"

msgid "All Terminals and Honors"
msgstr "Nur Endsteine und Ehren"

msgid "All Terminals"
msgstr "Nur Endsteine"

msgid "All Honors"
msgstr "Nur Ehren"

msgid "Thirteen Orphans"
msgstr "Dreizehn Waisen"

msgid "A copy of each Terminal and Honor tile,<br>plus one last of your choice among these 13 tiles."
msgstr "Jeder Endstein und jede Ehre einmal,<br>plus ein beliebiger weiterer dieser 13 Steine."

# ——— YAKUS BASED ON PAIRS / TRIPLETS / QUADS ———

msgid "Yakus based on pairs / triplets / quads"
msgstr "Auf paaren/zwillingen/drillingen basierende yaku"

msgid "Seven Pairs"
msgstr "Sieben Paare"

msgid "Doubles pairs are not allowed."
msgstr "Doppelte Paare sind nicht erlaubt."

msgid "All Triplets"
msgstr "Nur Drillinge"

msgid "Three Concealed Triplets"
msgstr "Drei Verdeckte Drillinge"

msgid "Four Concealed Triplets"
msgstr "Vier Verdeckte Drillinge"

msgid "Three Colored Triplets"
msgstr "Drei Gemischte Drillinge"

msgid "Three Quads"
msgstr "Drei Vierlinge"

msgid "Four Quads"
msgstr "Vier Vierlinge"

# ——— YAKUS BASED ON SUITS ———

msgid "Yakus based on suits"
msgstr "Auf farben basierende yaku"

msgid "Half Flush"
msgstr "Gemischtes Farbspiel"

msgid "A single suit and Honors."
msgstr "Eine Farbe und Ehren."

msgid "Flush"
msgstr "Reines Farbspiel"

msgid "All Green"
msgstr "Grüne Hand"

msgid "Only use 2, 3, 4, 6, 8 of Bamboo, and/or Green Dragon."
msgstr "Besteht ausschließlich aus den Bambus 2, 3, 4, 6, 8 und dem grünen Drachen."

msgid "Nine Gates"
msgstr "Neun Laternen"

msgid "Tiles 1112345678999, plus one last of your choice, in a single suit."
msgstr "Die Steine 1112345678999, plus ein beliebiger weiterer daraus, in einer Farbe."

